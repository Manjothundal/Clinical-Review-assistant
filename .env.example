# Copy this file, rename the copy to  .env  and fill it in.
# Never commit the real .env to Git. The .gitignore already blocks it.
#
# You do not need any of this to use the app. Leave it as it is and run
#     python run_review.py --no-model
# Everything works, and every word on the sheet comes from code.

# mock      = no AI at all. Everything runs. Start here.
# openai    = OpenAI or Azure OpenAI. Use this when IT gives you a key.
# anthropic = Claude. Same, with an Anthropic key.
# paste     = no API key at all, only the ChatGPT website. The app writes the
#             prompt to out/prompt_to_paste.txt, you paste it into ChatGPT, and
#             you save the reply into out/answer_from_chatgpt.txt.
CRA_MODEL_MODE=mock

# Your key. Leave blank while the mode is mock or paste.
CRA_API_KEY=

# Which model to use once the mode is openai or anthropic.
# Leave blank for the cheap default: gpt-4.1-mini (openai) or
# claude-haiku-4-5 (anthropic). Answers are saved, so a rerun costs nothing.
CRA_MODEL_NAME=

# Only for Azure OpenAI or another OpenAI-compatible endpoint.
# Your IT team will give you this if the company uses Azure.
# Leave blank for normal OpenAI.
CRA_API_BASE=

# The agent. Leave blank to use CRA_MODEL_NAME or the cheap default.
CRA_AGENT_MODEL=
# Most tool calls one agent run may make.
CRA_AGENT_STEPS=10
